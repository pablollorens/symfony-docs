{% extends 'base.html.twig' %}
{% block title %}Nueva Sala — Admin{% endblock %}
{% block body %}
<div style="max-width: 480px;">
    <div class="card">
        <h1>Nueva sala</h1>
        {{ form_start(form) }}
            <div class="form-group">{{ form_label(form.name) }}{{ form_widget(form.name) }}</div>
            <div class="form-group">{{ form_label(form.capacity) }}{{ form_widget(form.capacity) }}</div>
            <div class="form-group">
                {{ form_label(form.equipment) }}
                {{ form_widget(form.equipment) }}
            </div>
            <div class="form-group">{{ form_label(form.hourlyRate) }}{{ form_widget(form.hourlyRate) }}</div>
            <div style="display:flex; gap:0.75rem; margin-top:1rem;">
                <button type="submit" class="btn btn-primary">Crear</button>
                <a href="{{ path('admin_room_index') }}" class="btn btn-secondary">Cancelar</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
