{% extends 'base.html.twig' %}
{% block title %}Nueva Reserva — CoWorking Space{% endblock %}
{% block body %}
<div style="max-width: 520px;">
    <div class="card">
        <h1>Nueva Reserva</h1>
        <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1.25rem;">
            Mínimo 1 hora, máximo 4 horas.
        </p>
        {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.room) }}
                {{ form_widget(form.room) }}
            </div>
            <div class="form-group">
                {{ form_label(form.startAt) }}
                {{ form_widget(form.startAt) }}
            </div>
            <div class="form-group">
                {{ form_label(form.endAt) }}
                {{ form_widget(form.endAt) }}
            </div>
            <div style="display:flex; gap:0.75rem; margin-top: 1.5rem;">
                <button type="submit" class="btn btn-primary">Reservar</button>
                <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">Cancelar</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
